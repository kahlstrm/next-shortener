DATABASE_URL= #libsql://<something>.turso.io
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY= #setup for this https://clerk.com/docs/nextjs/get-started-with-nextjs
CLERK_SECRET_KEY= # see above
